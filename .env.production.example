# Variáveis do docker-compose.prod.yml. Copie para .env (na raiz, ao lado do
# compose), preencha e dê chmod 600. Nunca versione o .env.
# Evite o caractere $ nos valores: o compose o interpreta.

# Domínio do painel e do webhook (o DNS já precisa apontar para este servidor,
# senão o Caddy não consegue o certificado) e o e-mail dos avisos do Let's Encrypt.
DOMAIN=
ACME_EMAIL=

# Senhas do MySQL. Gere cada uma com: openssl rand -hex 24
# (hexadecimal para não precisar escapar nada na URL de conexão)
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# MYSQL_DATABASE=incident_tracker
# MYSQL_USER=incident

# Obrigatório, mínimo 32 bytes. Gere com: openssl rand -base64 48
JWT_SECRET=

# Storage S3-compatível (Cloudflare R2). O bucket é criado à mão; a chave deve
# ser a do bucket, só com leitura e escrita de objetos.
STORAGE_ENDPOINT=https://ID_DA_CONTA.r2.cloudflarestorage.com
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# STORAGE_REGION=auto
# STORAGE_FORCE_PATH_STYLE=true
