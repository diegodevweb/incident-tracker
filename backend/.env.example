# Copie para .env e preencha. Nunca versione o .env.

PORT=3001
# Por padrão a API só escuta em 127.0.0.1. Em container use 0.0.0.0 e não publique a porta.
# HOST=127.0.0.1

# Quantos proxies confiáveis existem na frente da API (0 = nenhum: X-Forwarded-For é ignorado).
# Atrás do Next (que repassa o IP real do cliente) ou do Caddy, use 1.
# TRUST_PROXY=0

# Limites de tentativas de login (padrões abaixo; o estado fica em memória)
# AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5               # por IP + e-mail
# AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS_PER_IP=30       # por IP, qualquer e-mail
# AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS_PER_ACCOUNT=20  # por e-mail, qualquer IP
# AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
# AUTH_LOGIN_RATE_LIMIT_BLOCK_MS=900000

DATABASE_URL="mysql://incident:incident@localhost:3307/incident_tracker"

# Obrigatório, mínimo 32 bytes. Gere com: openssl rand -base64 48
JWT_SECRET=

# Webhook de logs de erro: não há chave global. Cada cliente tem as próprias
# chaves (header x-api-key), criadas por um admin em POST /clients/:clientId/webhook-keys.

# Armazenamento S3-compatível (padrão: SeaweedFS do docker-compose; a chave
# precisa ser a mesma das variáveis AWS_* do serviço seaweedfs)
STORAGE_REGION=us-east-1
STORAGE_BUCKET=incident-tracker
STORAGE_ENDPOINT=http://localhost:9003
STORAGE_ACCESS_KEY_ID=incident
STORAGE_SECRET_ACCESS_KEY=incident-dev-storage
STORAGE_FORCE_PATH_STYLE=true
# STORAGE_SIGNED_URL_EXPIRES_IN_SECONDS=900

# Usuários de desenvolvimento: só são criados com SEED_DEV_USERS=true,
# nunca com NODE_ENV=production, e usuários que já existem não são alterados.
# SEED_DEV_USERS=true
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=          # política em src/auth/password-policy.ts: 12+ caracteres, sem senha comum nem o início do e-mail
# SEED_CLIENT_EMAIL=cliente@example.com
# SEED_CLIENT_PASSWORD=         # mesma política
