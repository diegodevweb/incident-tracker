// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum IncidentStatus {
  OPEN
  PENDING
  IN_PROGRESS
  RESOLVED
}

enum IncidentLevel {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum IncidentSource {
  WEBHOOK
  DASHBOARD
}

enum AttachmentCategory {
  GENERAL
  CORRECTIVE_ACTION
}

enum UserRole {
  ADMIN
  CLIENT
}

enum IncidentEventType {
  INCIDENT_CREATED
  STATUS_CHANGED
  INCIDENT_RESOLVED
  CORRECTIVE_ACTION_ADDED
  CORRECTIVE_ACTION_REMOVED
  ATTACHMENT_ADDED
}

model User {
  id                 Int             @id @default(autoincrement())
  name               String
  email              String          @unique
  password           String
  role               UserRole        @default(CLIENT)
  tokenVersion       Int             @default(0)
  /// Senha temporária (criada ou redefinida pelo admin): só dá para usar o
  /// painel depois de trocá-la.
  mustChangePassword Boolean         @default(false)
  /// Conta desativada: não entra e perde as sessões. Desativa-se em vez de
  /// apagar, porque eventos e chamados apontam para ela.
  disabledAt         DateTime?
  /// Empresa do usuário CLIENT (obrigatória para ele); nula para ADMIN.
  companyId          Int?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  company          Company?        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdIncidents Incident[]      @relation("IncidentCreatedBy")
  incidentEvents   IncidentEvent[]

  @@index([companyId])
}

/// Empresa cliente: agrupa os usuários CLIENT, os chamados e as chaves de
/// webhook. Não é apagada, é desativada.
model Company {
  id         Int       @id @default(autoincrement())
  name       String
  /// 14 caracteres sem pontuação (numérico ou alfanumérico); único quando informado.
  cnpj       String?   @unique @db.Char(14)
  /// Empresa desativada: nenhum usuário dela entra e as chaves de webhook param.
  disabledAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  users       User[]
  incidents   Incident[]
  webhookKeys WebhookKey[]
}

model Incident {
  id                Int            @id @default(autoincrement())
  title             String
  description       String
  correctiveActions String?        @db.Text
  status            IncidentStatus @default(OPEN)
  priority          IncidentLevel  @default(INFO)
  source            IncidentSource @default(DASHBOARD)
  environment       String
  companyId         Int
  /// Quem abriu pelo painel; nulo quando veio do webhook ou é anterior ao registro de autoria.
  createdById       Int?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  company   Company @relation(fields: [companyId], references: [id])
  createdBy User?   @relation("IncidentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  attachments       IncidentAttachment[]
  logs              IncidentLog[]
  preventiveActions PreventiveAction[]
  events            IncidentEvent[]
}

model IncidentAttachment {
  id         Int                @id @default(autoincrement())
  incidentId Int
  filename   String
  mimeType   String
  url        String
  category   AttachmentCategory @default(GENERAL)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  incident Incident @relation(fields: [incidentId], references: [id])
}

model IncidentLog {
  id         Int           @id @default(autoincrement())
  incidentId Int
  message    String
  level      IncidentLevel @default(INFO)
  occurredAt DateTime?
  metadata   Json?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  incident   Incident      @relation(fields: [incidentId], references: [id])
}

model PreventiveAction {
  id          Int       @id @default(autoincrement())
  description String    @db.Text
  incidentId  Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  incident Incident? @relation(fields: [incidentId], references: [id])
}

/// Trilha de auditoria do chamado: quem mudou o quê e quando. Só recebe inserts.
model IncidentEvent {
  id         Int               @id @default(autoincrement())
  incidentId Int
  type       IncidentEventType
  /// Quem fez a mudança; nulo quando o chamado veio do webhook.
  actorId    Int?
  metadata   Json?
  createdAt  DateTime          @default(now())

  incident Incident @relation(fields: [incidentId], references: [id])
  /// Restrict: apagar um usuário não pode apagar nem anonimizar a autoria dos eventos.
  actor    User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([incidentId, createdAt])
}

/// Chave de webhook de uma empresa. Só o hash SHA-256 da chave é guardado; o
/// prefixo é público e serve para achar a chave e identificá-la nas listagens.
model WebhookKey {
  id         Int       @id @default(autoincrement())
  companyId  Int
  name       String
  prefix     String    @unique
  keyHash    String    @db.Char(64)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  /// Revogar não apaga a linha: o histórico de quais chaves existiram fica.
  revokedAt  DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
}
